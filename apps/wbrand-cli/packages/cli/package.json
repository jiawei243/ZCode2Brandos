{
  "name": "@wbrand/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Main CLI application for wbrand",
  "bin": {
    "wbrand": "./dist/wbrand.cjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/wbrand.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:desktop-agent": "node scripts/build.mjs --desktop-agent",
    "build:sea": "pnpm --dir ../../../.. exec turbo --skip-infer --cwd apps/wbrand-cli run build --filter=!@wbrand/cli --force && pnpm build && node scripts/build-sea.mjs --all",
    "sea": "node scripts/build-sea.mjs",
    "upload:sea": "node scripts/upload-sea-smb.mjs",
    "clean": "node ../../scripts/clean-dist.mjs",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint --write src"
  },
  "dependencies": {
    "@wbrand/adapters": "workspace:*",
    "@wbrand/bootstrap": "workspace:*",
    "@wbrand/contracts": "workspace:*",
    "@wbrand/core": "workspace:*",
    "@wbrand/dynamic-workflow-runtime": "workspace:*",
    "@wbrand/i18n": "workspace:*",
    "@wbrand/provider-node": "workspace:*",
    "@wbrand/shared": "workspace:*",
    "@wbrand/shared-types": "workspace:*",
    "@wbrand/tui": "workspace:*",
    "dotenv": "^17.4.2",
    "playwright-core": "1.59.1"
  }
}
